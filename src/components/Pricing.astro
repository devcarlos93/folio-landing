---
import { strings, pricing } from "../i18n/strings";

const s = strings.es;
const p = pricing.es;

const freeItems = ["f1", "f2", "f3", "f4", "f5", "f6", "f7", "f8"] as const;
const proItems = ["p1", "p2", "p3", "p4", "p5", "p6"] as const;
const fine = ["fine1", "fine2", "fine3"] as const;
---

<section id="planes" class="bg-card px-5 py-[clamp(72px,10vw,128px)] sm:px-10">
  <div class="mx-auto max-w-[920px]">
    <h2
      class="mx-auto max-w-[720px] text-center text-[clamp(36px,5vw,64px)] font-extrabold leading-[1] tracking-[-0.035em] text-wrap-balance"
      data-i18n="plH"
    >
      {s.plH}
    </h2>

    <div class="mt-8 flex justify-center sm:mt-[clamp(32px,4vw,48px)]">
      <div class="flex gap-1 rounded-[28px] bg-paper p-1" role="group" aria-label="Facturación / Billing">
        <button
          type="button"
          data-billing-option="annual"
          aria-pressed="true"
          class="flex h-12 items-center justify-center rounded-full bg-ink px-5 text-base font-bold text-card"
        >
          {p.annualLabel}
        </button>
        <button
          type="button"
          data-billing-option="monthly"
          aria-pressed="false"
          class="flex h-12 items-center justify-center rounded-full px-5 text-base font-bold text-ink"
        >
          {p.monthlyLabel}
        </button>
      </div>
    </div>

    <div class="mt-6 grid items-stretch gap-4 sm:mt-9" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr))">
      <!-- Gratis -->
      <div class="flex flex-col gap-6 rounded-[32px] bg-paper p-7 sm:p-8">
        <div>
          <div class="text-xl font-extrabold" data-i18n="free">{s.free}</div>
          <div class="mt-3.5 flex items-baseline gap-1.5">
            <span class="text-[52px] font-extrabold leading-none tracking-[-0.03em]">$0</span>
          </div>
          <div class="mt-1.5 text-[15px] text-ink-soft" data-i18n="forever">{s.forever}</div>
        </div>
        <ul class="grid gap-3 text-base leading-[1.4]">
          {
            freeItems.map((k) => (
              <li class="flex gap-2.5">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#141412" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true">
                  <path d="M5 12.5l4.5 4.5L19 7" />
                </svg>
                <span data-i18n={k}>{s[k]}</span>
              </li>
            ))
          }
        </ul>
        <a
          href="#descargar"
          class="mt-auto flex h-[54px] items-center justify-center rounded-full border-[1.5px] border-ink text-base font-bold"
          data-i18n="startFree">{s.startFree}</a
        >
      </div>

      <!-- Pro -->
      <div class="relative flex flex-col gap-6 rounded-[32px] bg-ink p-7 text-card sm:p-8">
        <div
          class="absolute right-7 top-7 flex h-7 items-center rounded-2xl bg-yellow px-3 text-[13px] font-bold text-ink"
          data-i18n="rec"
        >
          {s.rec}
        </div>
        <div>
          <div class="text-xl font-extrabold" data-i18n="pro">{s.pro}</div>
          <div class="mt-3.5 flex items-baseline gap-1.5" aria-live="polite">
            <span class="text-[52px] font-extrabold leading-none tracking-[-0.03em]" data-pro-price>{p.annual.price}</span>
            <span class="text-[17px] text-muted" data-pro-per>{p.annual.per}</span>
          </div>
          <div class="mt-1.5 text-[15px] text-muted" data-pro-sub>{p.annual.sub}</div>
        </div>
        <div>
          <div class="text-[15px] font-semibold text-muted" data-i18n="p0">{s.p0}</div>
          <ul class="mt-3 grid gap-3 text-base leading-[1.4]">
            {
              proItems.map((k) => (
                <li class="flex gap-2.5">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ECE67E" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true">
                    <path d="M5 12.5l4.5 4.5L19 7" />
                  </svg>
                  <span data-i18n={k}>{s[k]}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <a
          href="#descargar"
          class="mt-auto flex h-[54px] items-center justify-center rounded-full bg-card text-base font-bold text-ink"
          data-pro-cta>{p.annual.cta}</a
        >
      </div>
    </div>

    <ul class="mx-auto mt-8 grid max-w-[720px] gap-2 text-center text-[14px] leading-[1.5] text-ink-soft">
      {fine.map((k) => <li class="text-wrap-pretty" data-i18n={k}>{s[k]}</li>)}
    </ul>
  </div>
</section>
