---
interface Props {
  size?: number;
  textSize?: string;
  dark?: boolean;
  href?: string;
}

const { size = 38, textSize = "text-[26px]", dark = false, href = "#top" } = Astro.props;
---

<a href={href} class="flex items-center gap-2.5" aria-label="Folio">
  <img
    src="/icon-192.png"
    alt=""
    aria-hidden="true"
    width={size}
    height={size}
    class="shrink-0 rounded-[10px]"
    style={`width:${size}px;height:${size}px`}
  />
  <span class:list={["font-extrabold tracking-tight", textSize, dark ? "text-card" : "text-ink"]}>Folio</span>
</a>
