---
interface Props {
  size?: number;
  textSize?: string;
  dark?: boolean;
}

const { size = 38, textSize = "text-[26px]", dark = false } = Astro.props;
---

<a href="#top" class="flex items-center gap-2.5">
  <div
    class="shrink-0 overflow-hidden rounded-[10px] bg-brand"
    style={`width:${size}px;height:${size}px`}
  >
    <svg width="100%" height="100%" viewBox="0 0 100 100">
      <path
        d="M50 14 78 28.5 50 43 22 28.5z"
        fill="#F6F4EE"
        stroke="#F6F4EE"
        stroke-width="3"
        stroke-linejoin="round"></path>
      <path
        d="M19 36.5 46 50.5 46 85 19 71z"
        fill="#F6F4EE"
        stroke="#F6F4EE"
        stroke-width="3"
        stroke-linejoin="round"></path>
      <path
        d="M54 50.5 81 36.5 81 71 54 85z"
        fill="#141412"
        stroke="#141412"
        stroke-width="3"
        stroke-linejoin="round"></path>
    </svg>
  </div>
  <span class:list={["font-extrabold tracking-tight", textSize, dark ? "text-card" : "text-ink"]}>Folio</span>
</a>
