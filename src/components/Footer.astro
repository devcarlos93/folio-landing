---
import Logo from "./Logo.astro";
import { strings } from "../i18n/strings";
import { CONTACT_EMAIL } from "../config/links";

const s = strings.es;
---

<footer class="bg-ink px-5 py-10 text-muted sm:px-10">
  <div class="mx-auto flex max-w-[1120px] flex-wrap items-center justify-between gap-x-8 gap-y-6 text-[15px]">
    <Logo size={30} textSize="text-xl" dark href="/" />
    <div class="flex flex-wrap gap-x-6 gap-y-3">
      <a href="/privacidad" class="text-muted" data-i18n="privacy">{s.privacy}</a>
      <a href="/terminos" class="text-muted" data-i18n="terms">{s.terms}</a>
      <a href="/eliminar-cuenta" class="text-muted" data-i18n="delAcc">{s.delAcc}</a>
      <a href={`mailto:${CONTACT_EMAIL}`} class="text-muted" data-i18n="support">{s.support}</a>
    </div>
    <div>© 2026 Folio · <span data-i18n="madeIn">{s.madeIn}</span></div>
  </div>
</footer>
