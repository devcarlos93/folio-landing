---
import Logo from "./Logo.astro";
import LangSwitch from "./LangSwitch.astro";
import { strings } from "../i18n/strings";

const s = strings.es;
const links = [
  { href: "#como", key: "how" },
  { href: "#compartir", key: "share" },
  { href: "#dia-de-pago", key: "payday" },
  { href: "#planes", key: "plans" },
] as const;
---

<nav class="mx-auto flex max-w-6xl items-center justify-between gap-5 px-5 py-[22px] sm:px-10" aria-label="Folio">
  <Logo />
  <div class="flex items-center justify-end gap-3 text-base font-semibold lg:gap-7">
    {
      links.map((l) => (
        <a href={l.href} class="hidden lg:inline" data-i18n={l.key}>
          {s[l.key]}
        </a>
      ))
    }
    <LangSwitch />
    <a
      href="#descargar"
      data-i18n="download"
      class="flex h-11 items-center rounded-full bg-ink px-5 text-card">{s.download}</a
    >
  </div>
</nav>
