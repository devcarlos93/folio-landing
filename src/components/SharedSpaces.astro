---
import IPhoneFrame from "./devices/IPhoneFrame.astro";
import { strings } from "../i18n/strings";
import { screens } from "../config/screens";

const s = strings.es;

const points = [
  { t: "sh1t", b: "sh1b" },
  { t: "sh2t", b: "sh2b" },
  { t: "sh3t", b: "sh3b" },
  { t: "sh4t", b: "sh4b" },
  { t: "sh5t", b: "sh5b" },
  { t: "sh6t", b: "sh6b" },
] as const;
---

<section id="compartir" class="bg-card px-5 py-[clamp(72px,10vw,128px)] sm:px-10">
  <div class="mx-auto max-w-[1120px]">
    <h2
      class="max-w-[760px] text-[clamp(36px,5vw,64px)] font-extrabold leading-[1] tracking-[-0.035em] text-wrap-balance"
      data-i18n="shH"
    >
      {s.shH}
    </h2>
    <p class="mt-5 max-w-[640px] text-[19px] leading-[1.5] text-ink-soft text-wrap-pretty" data-i18n="shB">{s.shB}</p>

    <div
      class="mt-12 grid items-center gap-x-[clamp(40px,6vw,80px)] gap-y-14 sm:mt-16"
      style="grid-template-columns:repeat(auto-fit,minmax(min(100%,400px),1fr))"
    >
      <div class="relative mx-auto flex w-full max-w-[460px] flex-col items-center">
        <div
          class="absolute left-1/2 top-[42%] aspect-square w-[min(480px,110%)] -translate-x-1/2 -translate-y-1/2 rounded-full bg-blue opacity-50"
          aria-hidden="true"
        >
        </div>
        <IPhoneFrame src={screens.shared.src} alt={screens.shared.altEs} altKey="altShared" width={290} class="relative" />

        <div
          class="relative z-10 -mt-24 w-[min(310px,100%)] rounded-[22px] bg-paper p-4 text-left shadow-[0_18px_36px_rgba(20,20,18,.16)] sm:absolute sm:bottom-12 sm:left-0 sm:mt-0 sm:-rotate-2"
        >
          <div class="flex items-center justify-between gap-3">
            <div class="text-[15px] font-extrabold" data-i18n="exBkTitle">{s.exBkTitle}</div>
            <div class="rounded-full border border-ink/25 px-2 py-0.5 text-[11px] font-bold text-ink-soft" data-i18n="exTag">{s.exTag}</div>
          </div>
          <div class="mt-3 grid gap-2.5 text-[13px] leading-[1.35]">
            <div class="flex items-start justify-between gap-3 border-b border-ink/10 pb-2.5">
              <div>
                <div class="font-semibold" data-i18n="exBk1">{s.exBk1}</div>
                <div class="text-ink-soft" data-i18n="exBk1s">{s.exBk1s}</div>
              </div>
              <div class="shrink-0 font-extrabold">+$600.000</div>
            </div>
            <div class="flex items-start justify-between gap-3 border-b border-ink/10 pb-2.5">
              <div>
                <div class="font-semibold" data-i18n="exBk2">{s.exBk2}</div>
                <div class="text-ink-soft" data-i18n="exBk2s">{s.exBk2s}</div>
              </div>
              <div class="shrink-0 font-extrabold">−$45.000</div>
            </div>
            <div class="flex items-baseline justify-between gap-3 pt-0.5">
              <div class="text-[14px] font-bold" data-i18n="exBkTotal">{s.exBkTotal}</div>
              <div class="text-[20px] font-extrabold tracking-[-.4px]">$555.000</div>
            </div>
          </div>
        </div>
      </div>

      <div>
        <dl class="grid gap-x-8 gap-y-7" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr))">
          {
            points.map((p) => (
              <div>
                <dt class="text-[19px] font-extrabold tracking-[-.3px]" data-i18n={p.t}>{s[p.t]}</dt>
                <dd class="mt-1.5 text-[16px] leading-[1.5] text-ink-soft text-wrap-pretty" data-i18n={p.b}>{s[p.b]}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-9 rounded-[22px] bg-paper p-5 text-[15px] leading-[1.55] text-ink-soft text-wrap-pretty" data-i18n="shNote">
          {s.shNote}
        </p>
      </div>
    </div>
  </div>
</section>
