---
import Logo from "./Logo.astro";
import { strings } from "../i18n/strings";

const s = strings.es;
---

<nav class="mx-auto flex max-w-6xl items-center justify-between gap-5 px-5 py-[22px] sm:px-10">
  <a href="/">
    <Logo />
  </a>
  <div class="flex items-center gap-3">
    <div class="flex gap-0.5 rounded-full bg-line p-[3px]">
      <button
        type="button"
        data-lang-option="es"
        class="flex h-[34px] min-w-[44px] items-center justify-center rounded-full bg-ink px-2.5 text-sm font-bold text-card"
      >
        ES
      </button>
      <button
        type="button"
        data-lang-option="en"
        class="flex h-[34px] min-w-[44px] items-center justify-center rounded-full px-2.5 text-sm font-bold text-ink"
      >
        EN
      </button>
    </div>
    <a
      href="/"
      class="flex h-11 items-center gap-2 rounded-full border-[1.5px] border-ink px-5 text-base font-bold"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 5l-7 7 7 7"></path>
      </svg>
      <span data-i18n="back">{s.back}</span>
    </a>
  </div>
</nav>
