---
import Logo from "./Logo.astro";
import LangSwitch from "./LangSwitch.astro";
import { strings } from "../i18n/strings";

const s = strings.es;
---

<nav class="mx-auto flex max-w-6xl items-center justify-between gap-5 px-5 py-[22px] sm:px-10">
  <Logo href="/" />
  <div class="flex items-center gap-3">
    <LangSwitch />
    <a
      href="/"
      class="flex h-11 items-center gap-2 rounded-full border-[1.5px] border-ink px-4 text-base font-bold sm:px-5"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 5l-7 7 7 7"></path>
      </svg>
      <span class="sr-only sm:not-sr-only" data-i18n="back">{s.back}</span>
    </a>
  </div>
</nav>
