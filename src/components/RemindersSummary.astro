---
import IPhoneFrame from "./devices/IPhoneFrame.astro";
import { strings } from "../i18n/strings";
import { screens } from "../config/screens";

const s = strings.es;

const notifications = [
  { text: "remN1", when: "remWhen1" },
  { text: "remN2", when: "remWhen2" },
] as const;
---

<section class="px-5 pb-[clamp(72px,10vw,128px)] sm:px-10">
  <div
    class="mx-auto grid max-w-[1120px] gap-5"
    style="grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr))"
  >
    <div class="flex flex-col gap-7 rounded-[36px] bg-card p-7 sm:p-[clamp(28px,4vw,44px)]">
      <div>
        <h3
          class="text-[clamp(28px,3vw,38px)] font-extrabold leading-[1.05] tracking-[-0.03em] text-wrap-balance"
          data-i18n="remH"
        >
          {s.remH}
        </h3>
        <p class="mt-3 text-[17px] leading-[1.5] text-ink-soft text-wrap-pretty" data-i18n="remB">{s.remB}</p>
      </div>
      <div class="mt-auto grid gap-2.5">
        {
          notifications.map((n) => (
            <div class="flex gap-3 rounded-[20px] bg-paper px-3.5 py-3">
              <img src="/icon-192.png" alt="" aria-hidden="true" width="36" height="36" class="h-9 w-9 shrink-0 rounded-[9px]" />
              <div class="min-w-0 flex-1">
                <div class="flex justify-between gap-3 text-xs text-ink-soft">
                  <span class="font-bold text-ink">Folio</span>
                  <span data-i18n={n.when}>{s[n.when]}</span>
                </div>
                <div class="mt-0.5 text-[15px] font-semibold leading-[1.3]" data-i18n={n.text}>{s[n.text]}</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="flex flex-col gap-7 overflow-hidden rounded-[36px] bg-ink px-7 pt-7 text-card sm:px-[clamp(28px,4vw,44px)] sm:pt-[clamp(28px,4vw,44px)]">
      <div>
        <h3
          class="text-[clamp(28px,3vw,38px)] font-extrabold leading-[1.05] tracking-[-0.03em] text-wrap-balance"
          data-i18n="sumH"
        >
          {s.sumH}
        </h3>
        <p class="mt-3 text-[17px] leading-[1.5] text-muted text-wrap-pretty" data-i18n="sumB">{s.sumB}</p>
      </div>
      <div class="mt-auto flex h-[320px] justify-center overflow-hidden">
        <IPhoneFrame src={screens.summary.src} alt={screens.summary.altEs} altKey="altSummary" width={280} />
      </div>
    </div>
  </div>
</section>
