---
import { Image } from "astro:assets";
import spacesPhone from "../assets/images/img-7649-spaces.png";
import { strings } from "../i18n/strings";

const s = strings.es;
---

<section id="espacios" class="px-5 py-[clamp(72px,10vw,128px)] sm:px-10">
  <div
    class="mx-auto grid max-w-[1120px] items-center gap-10 sm:gap-[clamp(40px,6vw,80px)]"
    style="grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr))"
  >
    <div>
      <div class="text-sm font-bold uppercase tracking-[.14em] text-ink-soft" data-i18n="spaces">{s.spaces}</div>
      <h2
        class="mt-4 text-[clamp(36px,5vw,64px)] font-extrabold leading-[1] tracking-[-0.04em] text-wrap-balance"
        data-i18n="spH"
      >
        {s.spH}
      </h2>
      <p class="mt-5 max-w-[480px] text-[19px] leading-[1.5] text-ink-soft text-wrap-pretty" data-i18n="spB">{s.spB}</p>

      <div class="mt-8 grid max-w-[440px] grid-cols-2 gap-2.5">
        <div class="flex h-24 flex-col justify-between rounded-[22px] bg-green px-4 py-3.5">
          <div class="flex items-center justify-between">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#141412" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 11 12 3l9 8M5 9.5V21h5v-6h4v6h5V9.5"></path>
            </svg>
            <div class="flex">
              <div class="flex h-6 w-6 items-center justify-center rounded-full border-[1.5px] border-ink bg-brand text-[11px] font-extrabold">A</div>
              <div class="-ml-[7px] flex h-6 w-6 items-center justify-center rounded-full border-[1.5px] border-ink bg-blue text-[11px] font-extrabold">C</div>
            </div>
          </div>
          <div class="text-[17px] font-bold" data-i18n="home">{s.home}</div>
        </div>
        <div class="flex h-24 flex-col justify-between rounded-[22px] bg-orange px-4 py-3.5">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#141412" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 16V11l2-5h10l2 5v5M3 16h18v3H3zM7 19v2M17 19v2M5 11h14"></path>
          </svg>
          <div class="text-[17px] font-bold" data-i18n="car">{s.car}</div>
        </div>
        <div class="flex h-24 flex-col justify-between rounded-[22px] bg-yellow px-4 py-3.5">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#141412" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="7" width="18" height="13" rx="2"></rect>
            <path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M3 13h18"></path>
          </svg>
          <div class="text-[17px] font-bold" data-i18n="biz">{s.biz}</div>
        </div>
        <div class="flex h-24 flex-col justify-between rounded-[22px] bg-pink px-4 py-3.5">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#141412" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"></path>
          </svg>
          <div class="text-[17px] font-bold" data-i18n="health">{s.health}</div>
        </div>
      </div>
    </div>

    <div class="relative flex justify-center">
      <div
        class="absolute left-1/2 top-1/2 aspect-square w-[min(520px,100%)] -translate-x-1/2 -translate-y-1/2 rounded-full bg-pink opacity-45"
      >
      </div>
      <div
        class="relative w-[290px] rounded-[50px] bg-night p-2.5 shadow-[0_34px_70px_rgba(20,20,18,.2),inset_0_0_0_1.5px_#2A2A27]"
      >
        <div class="aspect-[1186/2576] overflow-hidden rounded-[40px] bg-paper">
          <Image
            src={spacesPhone}
            alt="Folio · Espacio compartido"
            width={580}
            height={1262}
            class="block h-full w-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>
