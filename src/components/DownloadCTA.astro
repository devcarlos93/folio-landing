---
import { strings } from "../i18n/strings";

const s = strings.es;
const bubbleCount = 6;
---

<section id="descargar" class="relative overflow-hidden bg-brand px-5 pb-[clamp(72px,9vw,112px)] text-ink sm:px-10">
  <div class="-mx-10 flex h-[120px] justify-center">
    {
      Array.from({ length: bubbleCount }).map((_, i) => (
        <div
          class:list={["mt-[-140px] h-[240px] w-[360px] shrink-0 rounded-full bg-paper", i > 0 && "-ml-10"]}
        />
      ))
    }
  </div>
  <div class="mx-auto flex max-w-[800px] flex-col items-center text-center">
    <h2
      class="mt-10 text-[clamp(40px,6.4vw,84px)] font-extrabold leading-[0.98] tracking-[-0.045em] text-wrap-balance"
      data-i18n="ctaH"
    >
      {s.ctaH}
    </h2>
    <p class="mt-5 max-w-[520px] text-[19px] leading-[1.5] text-wrap-pretty" data-i18n="ctaB">{s.ctaB}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="#"
        class="flex h-[58px] items-center gap-2.5 rounded-full bg-ink px-6 text-[17px] font-bold text-card"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M16.37 12.64c-.02-2.3 1.88-3.4 1.96-3.46-1.07-1.56-2.73-1.78-3.32-1.8-1.41-.14-2.76.83-3.47.83-.72 0-1.82-.81-3-.79-1.54.02-2.96.9-3.76 2.28-1.6 2.78-.41 6.9 1.15 9.15.76 1.1 1.67 2.34 2.86 2.3 1.15-.05 1.58-.74 2.97-.74 1.38 0 1.77.74 2.98.72 1.23-.02 2.01-1.12 2.76-2.23.87-1.28 1.23-2.52 1.25-2.58-.03-.01-2.4-.92-2.38-3.68zM14.1 5.9c.63-.77 1.06-1.83.94-2.9-.91.04-2.02.61-2.67 1.37-.58.67-1.1 1.76-.96 2.8 1.02.08 2.06-.52 2.69-1.27z"
          ></path>
        </svg>
        App Store
      </a>
      <a
        href="#"
        class="flex h-[58px] items-center gap-2.5 rounded-full bg-card px-6 text-[17px] font-bold text-ink"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M4 2.8v18.4c0 .5.5.8.9.6L20.6 13c.5-.3.5-1 0-1.3L4.9 2.2c-.4-.2-.9.1-.9.6z"></path>
        </svg>
        Google Play
      </a>
    </div>
  </div>
</section>
