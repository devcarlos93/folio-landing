---
import StoreButtons from "./StoreButtons.astro";
import { strings } from "../i18n/strings";
import { storesLive } from "../config/links";

const s = strings.es;
const bubbleCount = 6;
const bodyKey = storesLive ? "ctaB" : "ctaBSoon";
---

<section id="descargar" class="relative overflow-hidden bg-brand px-5 pb-[clamp(72px,9vw,112px)] text-ink sm:px-10">
  <div class="-mx-10 flex h-[120px] justify-center" aria-hidden="true">
    {
      Array.from({ length: bubbleCount }).map((_, i) => (
        <div
          class:list={["mt-[-140px] h-[240px] w-[360px] shrink-0 rounded-full bg-paper", i > 0 && "-ml-10"]}
        />
      ))
    }
  </div>
  <div class="mx-auto flex max-w-[800px] flex-col items-center text-center">
    <h2
      class="mt-10 text-[clamp(40px,6.4vw,84px)] font-extrabold leading-[0.98] tracking-[-0.04em] text-wrap-balance"
      data-i18n="ctaH"
    >
      {s.ctaH}
    </h2>
    <p class="mt-5 max-w-[520px] text-[19px] leading-[1.5] text-wrap-pretty" data-i18n={bodyKey}>{s[bodyKey]}</p>
    <StoreButtons tone="brand" class="mt-8" />
  </div>
</section>
