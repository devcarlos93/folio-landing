---
import { strings } from "../i18n/strings";

const s = strings.es;

const items = [
  { t: "dt1t", b: "dt1b", icon: '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M11 18.5h2"/>' },
  { t: "dt2t", b: "dt2b", icon: '<path d="M7 18a4.5 4.5 0 0 1-.6-8.96A6 6 0 0 1 18 9.5a4 4 0 0 1-.5 8.5z"/>' },
  { t: "dt3t", b: "dt3b", icon: '<path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/>' },
  { t: "dt4t", b: "dt4b", icon: '<path d="M4 7h16"/><path d="M10 11v6M14 11v6"/><path d="M6 7l1 13h10l1-13"/><path d="M9 7V4h6v3"/>' },
] as const;
---

<section id="datos" class="px-5 pb-[clamp(72px,10vw,128px)] sm:px-10">
  <div class="mx-auto max-w-[1120px] border-t border-ink/12 pt-[clamp(48px,6vw,72px)]">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
      <h2
        class="max-w-[640px] text-[clamp(32px,4vw,52px)] font-extrabold leading-[1.02] tracking-[-0.035em] text-wrap-balance"
        data-i18n="dtH"
      >
        {s.dtH}
      </h2>
      <a href="/privacidad" class="text-base font-bold underline decoration-2 underline-offset-[5px]" data-i18n="dtLink">{s.dtLink}</a>
    </div>
    <dl class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        items.map((x) => (
          <div>
            <dt class="flex items-start gap-2.5 text-[18px] font-extrabold tracking-[-.2px]">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" class="mt-[2px] shrink-0" aria-hidden="true">
                <Fragment set:html={x.icon} />
              </svg>
              <span data-i18n={x.t}>{s[x.t]}</span>
            </dt>
            <dd class="mt-2 text-[16px] leading-[1.5] text-ink-soft text-wrap-pretty" data-i18n={x.b}>{s[x.b]}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
