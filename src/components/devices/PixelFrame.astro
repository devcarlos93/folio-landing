---
// Marco de Google Pixel (Pro XL) en HTML/CSS. Recibe una captura vertical (proporción 1344 × 2992).
interface Props {
  src: string;
  alt: string;
  altKey?: string;
  width?: number;
  eager?: boolean;
  class?: string;
}

const { src, alt, altKey, width = 300, eager = false, class: className } = Astro.props;
---

<div class:list={["pixel", className]} style={`--w:${width}px`}>
  <span class="btn power" aria-hidden="true"></span>
  <span class="btn volume" aria-hidden="true"></span>
  <div class="body">
    <div class="screen">
      <img
        src={src}
        alt={alt}
        data-i18n-alt={altKey}
        width="1344"
        height="2992"
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        fetchpriority={eager ? "high" : undefined}
      />
      <span class="camera" aria-hidden="true"></span>
    </div>
  </div>
</div>

<style>
  .pixel {
    position: relative;
    width: min(var(--w), 100%);
    container-type: inline-size;
    flex-shrink: 0;
  }
  .body {
    position: relative;
    aspect-ratio: 1344 / 2992;
    padding: 3.6cqw;
    border-radius: 12cqw;
    background: #121211;
    box-shadow:
      inset 0 0 0 1.1cqw #4a4843,
      inset 0 0 0 1.5cqw #232220,
      0 40px 80px rgba(20, 20, 18, 0.22),
      0 12px 24px rgba(20, 20, 18, 0.12);
  }
  .screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 8.6cqw;
    background: var(--color-line);
  }
  .screen img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .camera {
    position: absolute;
    top: 3cqw;
    left: 50%;
    width: 3.6cqw;
    height: 3.6cqw;
    transform: translateX(-50%);
    border-radius: 50%;
    background: #050505;
    box-shadow: inset 0 0 0 0.5cqw #1d1d1c;
  }
  .btn {
    position: absolute;
    right: -0.9cqw;
    width: 1.1cqw;
    border-radius: 1cqw;
    background: #3a3935;
  }
  .power { top: 22%; height: 8%; }
  .volume { top: 34%; height: 15%; }
</style>
