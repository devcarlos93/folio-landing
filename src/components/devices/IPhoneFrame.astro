---
// Marco de iPhone 17 Pro Max en HTML/CSS. Recibe una captura vertical (proporción 1320 × 2868).
interface Props {
  src: string;
  alt: string;
  altKey?: string;
  width?: number;
  eager?: boolean;
  class?: string;
}

const { src, alt, altKey, width = 300, eager = false, class: className } = Astro.props;
---

<div class:list={["iphone", className]} style={`--w:${width}px`}>
  <span class="btn action" aria-hidden="true"></span>
  <span class="btn vol-up" aria-hidden="true"></span>
  <span class="btn vol-down" aria-hidden="true"></span>
  <span class="btn power" aria-hidden="true"></span>
  <span class="btn camera" aria-hidden="true"></span>
  <div class="body">
    <div class="screen">
      <img
        src={src}
        alt={alt}
        data-i18n-alt={altKey}
        width="1320"
        height="2868"
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        fetchpriority={eager ? "high" : undefined}
      />
      <span class="island" aria-hidden="true"></span>
    </div>
  </div>
</div>

<style>
  .iphone {
    position: relative;
    width: min(var(--w), 100%);
    container-type: inline-size;
    flex-shrink: 0;
  }
  .body {
    position: relative;
    aspect-ratio: 1320 / 2868;
    padding: 3.1cqw;
    border-radius: 14.5cqw;
    background: #0b0b0a;
    box-shadow:
      inset 0 0 0 0.9cqw #3d3b37,
      inset 0 0 0 1.25cqw #1b1a18,
      0 40px 80px rgba(20, 20, 18, 0.22),
      0 12px 24px rgba(20, 20, 18, 0.12);
  }
  .screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 11.6cqw;
    background: var(--color-line);
  }
  .screen img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .island {
    position: absolute;
    top: 2.6cqw;
    left: 50%;
    width: 29cqw;
    height: 8.4cqw;
    transform: translateX(-50%);
    border-radius: 999px;
    background: #050505;
  }
  .btn {
    position: absolute;
    width: 1.1cqw;
    border-radius: 1cqw;
    background: #2e2d2a;
  }
  .action { left: -0.9cqw; top: 19%; height: 6%; }
  .vol-up { left: -0.9cqw; top: 28%; height: 10%; }
  .vol-down { left: -0.9cqw; top: 40%; height: 10%; }
  .power { right: -0.9cqw; top: 29%; height: 15%; }
  .camera { right: -0.9cqw; top: 60%; height: 8%; }
</style>
