---
// Selector de idioma. El script del cliente marca el activo y guarda la elección.
---

<div class="flex gap-0.5 rounded-full bg-line p-[3px]" role="group" aria-label="Idioma / Language">
  <button
    type="button"
    data-lang-option="es"
    aria-pressed="true"
    lang="es"
    class="flex h-[38px] min-w-[44px] items-center justify-center rounded-full bg-ink px-2.5 text-sm font-bold text-card"
  >
    ES
  </button>
  <button
    type="button"
    data-lang-option="en"
    aria-pressed="false"
    lang="en"
    class="flex h-[38px] min-w-[44px] items-center justify-center rounded-full px-2.5 text-sm font-bold text-ink"
  >
    EN
  </button>
</div>
